# テストが失敗したときだけ、そのテストの出力を表示する。
test --test_output=errors

# ホストの C/C++ コンパイラを自動検出したツールチェーンを使わない。
# C のソースからビルドするツールは、MODULE.bazel で登録した Zig のツールチェーンでビルドする。
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Go は cgo なしでビルドし、どのプラットフォーム向けでも静的にリンクする。
common --@rules_go//go/config:pure

# --stamp を付けたときに、イメージとマニフェストのタグに使うコミットを渡す。
build --workspace_status_command=tools/workspace_status.sh

# レジストリへの push は、コミットをタグに埋め込んで行う。bazel run --config=push で使う。
run:push --stamp

# 手元の kind の bazel-remote をリモートキャッシュに使う。bazel build --config=cache で使う。
common:cache --remote_cache=grpc://localhost:9092

# 手元の kind の Buildbarn でリモート実行する。bazel build --config=remote で使う。
common:remote --remote_executor=grpc://localhost:8980
common:remote --extra_execution_platforms=//platforms:remote_linux_amd64
# 同時に実行するアクションの数は、手元の CPU の数ではなくワーカーの数で決める。
common:remote --jobs=16
