# テストが失敗したときだけ、そのテストの出力を表示する。
test --test_output=errors

# ホストの C/C++ コンパイラを自動検出したツールチェーンを使わない。
# C のソースからビルドするツールは、MODULE.bazel で登録した Zig のツールチェーンでビルドする。
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Go は cgo なしでビルドし、どのプラットフォーム向けでも静的にリンクする。
common --@rules_go//go/config:pure

# --stamp を付けたときに、イメージとマニフェストのタグに使うコミットを渡す。
build --workspace_status_command=tools/workspace_status.sh

# レジストリへの push は、コミットをタグに埋め込んで行う。bazel run --config=push で使う。
run:push --stamp

# 手元の kind の bazel-remote をリモートキャッシュに使う。サーバーの証明書は tools/dev/certs/ca.pem で確かめる。
# 書き込めるのはクライアントの証明書を持つビルドだけなので、cache-write か cache-read のどちらかを使う。
common:cache --remote_cache=grpcs://localhost:9092
common:cache --tls_certificate=tools/dev/certs/ca.pem

# クライアントの証明書を持ち、キャッシュに書き込むビルド。bazel build --config=cache-write で使う。
common:cache-write --config=cache
common:cache-write --tls_client_certificate=tools/dev/certs/client.pem
common:cache-write --tls_client_key=tools/dev/certs/client.key

# 証明書を持たず、キャッシュを読むだけのビルド。bazel build --config=cache-read で使う。
common:cache-read --config=cache
common:cache-read --noremote_upload_local_results

# 手元の kind の Buildbarn でリモート実行する。bazel build --config=remote で使う。
common:remote --remote_executor=grpc://localhost:8980
common:remote --extra_execution_platforms=//platforms:remote_linux_amd64
# 同時に実行するアクションの数は、手元の CPU の数ではなくワーカーの数で決める。
common:remote --jobs=16

# ビルドの記録をファイルに残す。bazel build --config=observe で使う。
common:observe --build_event_json_file=bazel-bep.json
common:observe --execution_log_compact_file=bazel-exec.log
common:observe --profile=bazel-profile.json.gz

# 手元の kind の bb-portal にビルドのイベントを送る。
# kubectl -n buildbarn port-forward svc/portal-bes 18082:8082 と svc/portal 18081:8081 でつないでから使う。
common:portal --bes_backend=grpc://localhost:18082
common:portal --bes_results_url=http://localhost:18081/bazel-invocations/

# CI で使う。bazel test --config=ci で使う。
# MODULE.bazel.lock が MODULE.bazel と食い違っていたら、更新せずにエラーにする。
common:ci --lockfile_mode=error
# ログに書き出すので、進捗の表示を間引き、色を付ける。
common:ci --color=yes
common:ci --curses=no
common:ci --show_progress_rate_limit=5

# リリースで、GitHub Container Registry に push する。bazel run --config=release //deploy:push_release で使う。
# アーティファクトの注釈にコミットを入れるので、digest を求めるビルドにも --stamp を付ける。
common:release --stamp
common:release --//tools/build:registry=ghcr.io
common:release --//tools/build:repository_prefix=ymotongpoo/bazel-k8s-sample
