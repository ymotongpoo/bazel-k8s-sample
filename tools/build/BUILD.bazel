load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load(":kustomize.bzl", "kustomize_image_digests")

# マクロが作るテストだけが使うスクリプト。ほかのパッケージからは直接参照させない。
exports_files(
    [
        "healthz_test.sh",
        "image_digest_test.sh",
        "kubeconform_test.sh",
    ],
    visibility = ["//visibility:private"],
)

# イメージとマニフェストを push するレジストリと、リポジトリの接頭辞。
# 手元の kind のレジストリを既定にし、リリースでは .bazelrc の release の config で変える。
string_flag(
    name = "registry",
    build_setting_default = "localhost:5001",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "repository_prefix",
    build_setting_default = "bazel-k8s-sample",
    visibility = ["//visibility:public"],
)

kustomize_image_digests(
    name = "test_images",
    testonly = True,
    images = {
        "worker": "testdata/worker.digest",
        "api": "testdata/api.digest",
    },
)

diff_test(
    name = "kustomize_image_digests_test",
    size = "small",
    file1 = ":test_images",
    file2 = "testdata/kustomization.golden.yaml",
)
