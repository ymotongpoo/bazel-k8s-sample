load("@rules_go//go:def.bzl", "go_library")
load("//tools/build:go_service.bzl", "go_service")

go_library(
    name = "worker_lib",
    srcs = ["main.go"],
    importpath = "github.com/ymotongpoo/bazel-k8s-sample/services/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//proto/clicks/v1:clicks",
        "//services/worker/counter",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_service(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)
