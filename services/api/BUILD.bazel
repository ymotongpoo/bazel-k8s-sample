load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.sh"],
    args = ["$(rootpath :api)"],
    data = [":api"],
)

# //go:embed は同じパッケージの下のファイルしか埋め込めないので、//web:dist をここにコピーする。
copy_to_directory(
    name = "ui",
    srcs = ["//web:dist"],
    root_paths = ["web/dist"],
)

go_library(
    name = "api_lib",
    srcs = ["main.go"],
    embedsrcs = [":ui"],  # keep
    importpath = "github.com/ymotongpoo/bazel-k8s-sample/services/api",
    visibility = ["//visibility:private"],
    deps = [
        "//proto/shortener/v1:shortener",
        "//services/api/shortener",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_x_time//rate",
    ],
)
