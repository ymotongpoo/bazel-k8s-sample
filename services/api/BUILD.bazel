load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "smoke_test",
    srcs = ["smoke_test.sh"],
    args = ["$(rootpath :api)"],
    data = [":api"],
)

go_library(
    name = "api_lib",
    srcs = ["main.go"],
    importpath = "github.com/ymotongpoo/bazel-k8s-sample/services/api",
    visibility = ["//visibility:private"],
    deps = ["//services/api/shortener"],
)
