module(name = "bazel_k8s_sample")

bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "aspect_rules_js", version = "3.6.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "container_structure_test", version = "1.22.1")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "gazelle", version = "2.0.0-beta.2")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_shell", version = "0.10.0")
bazel_dep(name = "tar.bzl", version = "0.10.9")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.4")
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "org_golang_google_protobuf", "org_golang_x_time")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.13.1")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript", dev_dependency = True)
typescript.deps(version_from = "//:package.json")
use_repo(typescript, "npm_typescript")

esbuild = use_extension("@aspect_rules_esbuild//esbuild:extensions.bzl", "esbuild")
esbuild.toolchain(
    name = "esbuild",
    esbuild_version = "0.28.0",
)

# サービスのイメージのベース。タグではなく、マルチアーキテクチャのインデックスの digest で固定する。
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    digest = "sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5",  # static-debian13:nonroot
    image = "gcr.io/distroless/static-debian13",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "distroless_static", "distroless_static_linux_amd64", "distroless_static_linux_arm64_v8")

# マニフェストをレンダリングして検証するツール。バージョンとハッシュは tools/multitool.lock.json に書く。
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:multitool.lock.json")
use_repo(multitool, "multitool")

# kubeconform がマニフェストを検証するための Kubernetes 1.37.0 の JSON スキーマ。
# テストの中でネットワークからスキーマを取得させないように、ビルドの入力にする。
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "k8s_schema_deployment_apps_v1",
    downloaded_file_path = "deployment-apps-v1.json",
    sha256 = "0b64451c0b8c36ea06dfebf952718810ae24a07779fb0ed2a6b03f1cc8735a54",
    url = "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/e62c03bd5a52fd34ff6ac28d083e2a300e0ae7c1/v1.37.0-standalone-strict/deployment-apps-v1.json",
)

http_file(
    name = "k8s_schema_namespace_v1",
    downloaded_file_path = "namespace-v1.json",
    sha256 = "324fae677b98d1a6d54340db0c334d053e8ffbafceb3f73326e41de2610d5843",
    url = "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/e62c03bd5a52fd34ff6ac28d083e2a300e0ae7c1/v1.37.0-standalone-strict/namespace-v1.json",
)

http_file(
    name = "k8s_schema_service_v1",
    downloaded_file_path = "service-v1.json",
    sha256 = "8bf019854daed511e7c174896a898173fa65d88ec5937c687a37303d4cc9351b",
    url = "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/e62c03bd5a52fd34ff6ac28d083e2a300e0ae7c1/v1.37.0-standalone-strict/service-v1.json",
)

# ビルドに使うツールの一部（tar.bzl が使う gawk）は C のソースからビルドされる。
# ホストのコンパイラではなく、Zig の配布物に含まれる clang でビルドする。
zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "//tools/toolchains:all",
    "@zig_sdk//toolchain/...",
)
