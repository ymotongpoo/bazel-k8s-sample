load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "clicksv1_proto",
    srcs = ["clicks.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "clicksv1_go_proto",
    importpath = "github.com/ymotongpoo/bazel-k8s-sample/proto/clicks/v1",
    proto = ":clicksv1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "clicks",
    embed = [":clicksv1_go_proto"],
    importpath = "github.com/ymotongpoo/bazel-k8s-sample/proto/clicks/v1",
    visibility = ["//visibility:public"],
)
