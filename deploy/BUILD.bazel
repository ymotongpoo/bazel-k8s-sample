load("@rules_multirun//:defs.bzl", "multirun")
load("//tools/build:kustomize.bzl", "kustomize_build", "kustomize_image_digests")
load("//tools/build:manifests.bzl", "manifests_artifact")

# 2つのサービスのイメージのインデックスの digest を、images に書いた Component。
kustomize_image_digests(
    name = "images",
    images = {
        "api": "//services/api:api_index.digest",
        "worker": "//services/worker:worker_index.digest",
    },
)

# 手元の kind のクラスタ向けのマニフェスト。
kustomize_build(
    name = "dev",
    srcs = glob([
        "base/*.yaml",
        "overlays/dev/*.yaml",
    ]) + [":images"],
    image_digests = [
        "//services/api:api_index.digest",
        "//services/worker:worker_index.digest",
    ],
    overlay = "overlays/dev",
)

# dev のマニフェストのアーティファクト。Flux は dev のタグを見る。
manifests_artifact(
    name = "dev_manifests",
    manifests = ":dev",
    repository = "manifests",
    tags = ["dev"],
)

# 本番のマニフェスト。
kustomize_build(
    name = "prod",
    srcs = glob([
        "base/*.yaml",
        "overlays/prod/*.yaml",
    ]) + [":images"],
    image_digests = [
        "//services/api:api_index.digest",
        "//services/worker:worker_index.digest",
    ],
    overlay = "overlays/prod",
)

# 本番のマニフェストのアーティファクト。動くタグは付けず、Flux には digest で指定させる。
manifests_artifact(
    name = "prod_manifests",
    manifests = ":prod",
    repository = "manifests-prod",
)

# イメージを push してから、マニフェストを push する。bazel run --config=push //deploy:push_dev で使う。
multirun(
    name = "push_dev",
    commands = [
        "//services/api:api_push",
        "//services/worker:worker_push",
        ":dev_manifests_push",
    ],
)

# リリースで、イメージと本番のマニフェストを push する。bazel run --config=push //deploy:push_release で使う。
multirun(
    name = "push_release",
    commands = [
        "//services/api:api_push",
        "//services/worker:worker_push",
        ":prod_manifests_push",
    ],
)
